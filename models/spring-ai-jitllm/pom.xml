<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.ai</groupId>
		<artifactId>spring-ai-parent</artifactId>
		<version>2.1.0-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>spring-ai-jitllm</artifactId>
	<packaging>jar</packaging>
	<name>Spring AI Model - jitLLM</name>
	<description>jitLLM local chat model support</description>
	<url>https://github.com/spring-projects/spring-ai</url>

	<scm>
		<url>https://github.com/spring-projects/spring-ai</url>
		<connection>git://github.com/spring-projects/spring-ai.git</connection>
		<developerConnection>git@github.com:spring-projects/spring-ai.git</developerConnection>
	</scm>

	<properties>
		<!-- Java 21 bytecode, so the jar runs on JDK 21 and newer. The jitllm dependency
		     defaults to the JDK 22+ line (which the published POM carries); building on
		     JDK 21 switches it to the JDK 21 line through the jitllm-jdk21 profile. -->
		<java.version>21</java.version>
		<jitllm.version>${jitllm.base.version}-jdk22plus</jitllm.version>
		<jitllm.jvm.args>--add-modules jdk.incubator.vector</jitllm.jvm.args>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-model</artifactId>
			<version>${project.parent.version}</version>
		</dependency>

		<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>jitllm</artifactId>
			<version>${jitllm.version}</version>
		</dependency>

		<!-- test dependencies -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-client-chat</artifactId>
			<version>${project.parent.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-observation-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- jitllm uses the Vector API, an incubator module on every supported JDK. The
			     arguments are appended to the inherited ones, which keep the error-prone /
			     NullAway checks. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<compilerArgs combine.children="append">
						<arg>--add-modules</arg>
						<arg>jdk.incubator.vector</arg>
					</compilerArgs>
				</configuration>
				<executions>
					<execution>
						<id>java-compile</id>
						<configuration>
							<compilerArgs combine.children="append">
								<arg>--add-modules</arg>
								<arg>jdk.incubator.vector</arg>
							</compilerArgs>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>${jitllm.jvm.args}</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<argLine>${jitllm.jvm.args}</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<additionalOptions>
						<additionalOption>--add-modules</additionalOption>
						<additionalOption>jdk.incubator.vector</additionalOption>
					</additionalOptions>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- jitllm publishes one artifact per TornadoVM JDK line: -jdk21, and -jdk22plus for
		     every JDK from 22 up. -->
		<profile>
			<id>jitllm-jdk21</id>
			<activation>
				<jdk>[21,22)</jdk>
			</activation>
			<properties>
				<jitllm.version>${jitllm.base.version}-jdk21</jitllm.version>
				<!-- jitllm:*-jdk21 uses java.lang.foreign, a preview API on JDK 21 -->
				<jitllm.jvm.args>--enable-preview --add-modules jdk.incubator.vector</jitllm.jvm.args>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<compilerArgs combine.children="append">
								<arg>--enable-preview</arg>
							</compilerArgs>
						</configuration>
						<executions>
							<execution>
								<id>java-compile</id>
								<configuration>
									<compilerArgs combine.children="append">
										<arg>--enable-preview</arg>
									</compilerArgs>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<configuration>
							<additionalOptions combine.children="append">
								<additionalOption>--enable-preview</additionalOption>
							</additionalOptions>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
