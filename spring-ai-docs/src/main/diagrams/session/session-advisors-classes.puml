@startuml session-advisors-classes
!pragma layout smetana
set namespaceSeparator none
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

package "org.springframework.ai.chat.client.advisor.api" {
  interface CallAdvisor
  interface StreamAdvisor
  interface BaseAdvisor
}
class SessionAdvisors {
  {static} +builder(sessionService)
  {static} +session(sessionId)
  {static} +session(sessionId, runId)
  {static} +decisions(sessionId, decisions)
}
class "SessionAdvisors.Builder" as SAB {
  +compaction(trigger, strategy)
  +asyncCompaction(boolean)
  +interruptible(boolean)
  +toolCallingManager(manager)
  +scheduler(scheduler)
  +memory(customizer)
  +build(): List<Advisor>
}
class SessionTurnAdvisor {
  {static} DEFAULT_ORDER = HIGHEST_PRECEDENCE + 200
  {static} RUN_ID_CONTEXT_KEY
  {static} TOOL_CALL_DECISIONS_CONTEXT_KEY
  {static} UNANSWERED_TOOL_RESULT
  +adviseCall(request, chain)
  +adviseStream(request, chain)
  {static} +builder(sessionService)
}
class SessionInterruptAdvisor {
  {static} DEFAULT_ORDER = HIGHEST_PRECEDENCE + 1100
  +before(request, chain)
  +after(response, chain)
  {static} +builder(sessionService)
}
class TurnInterruptedException {
  +getSessionId()
  +getRunId()
  +getStatus(): TurnStatus
}
class SessionMemoryAdvisor {
  {static} SESSION_ID_CONTEXT_KEY
  {static} SESSION_METADATA_CONTEXT_KEY
  {static} EVENT_FILTER_CONTEXT_KEY
  {static} REQUEST_EVENT_ID_CONTEXT_KEY
  {static} RESPONSE_EVENT_IDS_CONTEXT_KEY
  +before(request, chain)
  +after(response, chain)
  {static} +builder(sessionService)
}
interface SessionService {
  +turns(): TurnService
}
class TurnService {
  +status(id)
  +start(id, runId, timeout)
  +end(id, runId, stopReason)
  +interrupt(id, reason)
  +park(id, runId, question)
  +pendingQuestion(id)
  +resume(id, runId, answer, timeout)
}
interface MessageFilter <<functional>> {
  +shouldPersist(message): boolean
}
class EventFilter
interface CompactionTrigger
interface CompactionStrategy

CallAdvisor <|.. SessionTurnAdvisor
StreamAdvisor <|.. SessionTurnAdvisor
BaseAdvisor <|.. SessionInterruptAdvisor
BaseAdvisor <|.. SessionMemoryAdvisor
SessionAdvisors +-- SAB
SAB ..> SessionTurnAdvisor : builds
SAB ..> SessionInterruptAdvisor : builds\nwith interruptible(true)
SAB ..> SessionMemoryAdvisor : builds
SessionTurnAdvisor --> SessionService
SessionTurnAdvisor --> TurnService : starts, ends, parks, resumes
SessionInterruptAdvisor --> TurnService : reads the status
SessionInterruptAdvisor ..> TurnInterruptedException : throws
SessionTurnAdvisor --> "0..1" CompactionTrigger
SessionTurnAdvisor --> "0..1" CompactionStrategy
SessionMemoryAdvisor --> SessionService
SessionService ..> TurnService : turns()
SessionMemoryAdvisor --> EventFilter : reads with
SessionMemoryAdvisor --> MessageFilter : stores through
@enduml
