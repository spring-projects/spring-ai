@startuml session-status-state
!pragma layout smetana
skinparam shadowing false
hide empty description

state RUNNING
RUNNING : the run id owns the turn
RUNNING : start by any run throws TurnInProgressException\nuntil the lease, if any, ran out
RUNNING : end and park by another run id are no-ops

state "IDLE" as IDLE
IDLE : no STATUS event yet, or the last turn ended
IDLE : interrupt(reason) appends INTERRUPT only

state "IDLE, parked" as PARKED
PARKED : the newest STATUS says REQUIRES_ACTION
PARKED : isParked() is true, start throws TurnParkedException
PARKED : interrupt(reason) appends INTERRUPT only

note right of RUNNING
  start(runId) after the lease ran out
  takes the turn over in one append:
  STATUS(IDLE, oldRunId, EXPIRED)
  + STATUS(RUNNING, runId)
end note

[*] --> IDLE
IDLE --> RUNNING : start(runId, timeout)\nappends STATUS(RUNNING, runId, expiresAt)
RUNNING --> IDLE : end(runId, stopReason)\nappends STATUS(IDLE, runId, stopReason)\n\ninterrupt(reason)\nappends INTERRUPT\n+ STATUS(IDLE, runId, INTERRUPTED)
RUNNING --> PARKED : park(runId, question)\nappends QUESTION\n+ STATUS(IDLE, runId, REQUIRES_ACTION)
PARKED --> RUNNING : resume(runId, answer, timeout)\nappends ANSWER\n+ STATUS(RUNNING, runId, expiresAt)
@enduml
